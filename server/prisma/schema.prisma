generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  group        String         @default("")
  role         String         @default("STUDENT")
  subjects     Subject[]
  schedule     ScheduleItem[]
  tasks        Task[]
  createdAt    DateTime       @default(now())
}


model VsuGroupSchedule {
  id        String   @id @default(uuid())
  groupCode String   @unique
  lessons   Json
  updatedAt DateTime @updatedAt
}

model Subject {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  lessonType       String         @default("Лабораторная")
  totalLessons     Int            @default(0)
  completedLessons Int            @default(0)
  totalLabs        Int            @default(0)
  completedLabs    Int            @default(0)
  scheduleItems    ScheduleItem[]
  tasks            Task[]
}

model ScheduleItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String
  time      String
  title     String
  room      String?
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  isOneTime Boolean  @default(false)
}

model Task {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  subject   String
  subjectId String?
  subjectEl Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  dueDate   String?
  done      Boolean  @default(false)
}
